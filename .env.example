# ==========================================
# BENT PLANET - ENVIRONMENT CONFIGURATION
# ==========================================

# --- 1. SUPABASE DATABASE & AUTH (REQUIRED) ---
# Obtain from your Supabase Project Settings -> API (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- 2. APPLICATION URL (REQUIRED) ---
# Base URL for public conference links, invites, and webhooks
NEXT_PUBLIC_APP_URL=https://bentplanet.com

# --- 3. AI GENERATION PROVIDERS (AT LEAST ONE OR ZERO FOR PRE-BUILT ENGINE) ---
# System automatically cascades through available providers with guaranteed faith-based fallback
# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
# Or alias: GOOGLE_AI_API_KEY=

# OpenRouter API Key (https://openrouter.ai/keys) - Used for vision flyer extraction & free text generation
OPENROUTER_API_KEY=

# DeepSeek API Key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# Anthropic Claude API Key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# --- 4. RESEND EMAIL SERVICE (REQUIRED FOR EMAILS) ---
# Obtain from Resend Dashboard -> API Keys (https://resend.com/api-keys)
RESEND_API_KEY=
# Verified domain sender email address (e.g. noreply@yourdomain.com)
RESEND_FROM_EMAIL=noreply@bentplanet.com

# --- 5. EXTERNAL STORAGE PROVIDERS (OPTIONAL) ---
# Default fallback uses Supabase Public CDN Storage automatically
# Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# External TeraBox or S3 Gateway URL
EXTERNAL_STORAGE_GATEWAY_URL=
EXTERNAL_STORAGE_API_KEY=

# --- 6. SUPER ADMIN & CRON SECURITY ---
# Super admin email(s) separated by comma
SUPER_ADMIN_EMAILS=superadmin@bentplanet.com
# Secret token to secure cron automated emails endpoint (/api/cron/reminders)
CRON_SECRET=your-random-secure-cron-secret-token

# --- 7. LINK SHORTENER & WHATSAPP INTEGRATION ---
# Bitly API Access Token (https://app.bitly.com/settings/api/)
# Used to generate short bit.ly links for conferences. If omitted, falls back to native URL slugs.
BITLY_ACCESS_TOKEN=your-bitly-access-token

# --- 8. SENTRY ERROR TRACKING & PERFORMANCE MONITORING (OPTIONAL) ---
# Obtain from Sentry Dashboard -> Project Settings -> Client Keys (DSN) (https://sentry.io)
NEXT_PUBLIC_SENTRY_DSN=https://your-public-key@o0.ingest.sentry.io/0
SENTRY_DSN=https://your-public-key@o0.ingest.sentry.io/0
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=bent-planet-saas
# Auth token for source maps upload in CI/CD (https://sentry.io/settings/account/api/auth-tokens/)
SENTRY_AUTH_TOKEN=

# --- 9. POSTHOG PRODUCT ANALYTICS & SESSION REPLAYS (OPTIONAL) ---
# Obtain from PostHog Dashboard -> Project Settings -> Project API Key (https://app.posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key
# Use https://us.i.posthog.com for US cloud or https://eu.i.posthog.com for EU cloud
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


b
